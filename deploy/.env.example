# Copy to ".env" and fill in real values. NEVER commit .env to git.
# Generate strong secrets with:  openssl rand -hex 32

# --- Public domain of the backend API (DNS A record -> your VPS IP) ---
API_DOMAIN=api.becho.com.bd

# --- MySQL ---
DB_NAME=becho
DB_USER=becho_app
DB_PASSWORD=CHANGE_ME_strong_random_password
DB_ROOT_PASSWORD=CHANGE_ME_strong_random_root_password

# --- Backend auth (must be long & random in production!) ---
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# --- Cloudflare R2 (product images + DB backups). Md creates these in the Cloudflare dashboard. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=becho-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# --- Mail: use a real SMTP provider in production (e.g. Resend / Amazon SES) ---
MAIL_HOST=
MAIL_PORT=587

# --- CORS: your storefront URL(s), comma-separated ---
CORS_ORIGINS=https://becho.com.bd

# --- Payments (fill in when you wire the providers) ---
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
